{
    "name": "Productivity Monitor",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "monitor",
                "responseMode": "lastNode",
                "options": {}
            },
            "name": "Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                460,
                300
            ],
            "webhookId": "monitor-webhook"
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json.body.action }}",
                            "operation": "isNotEmpty"
                        }
                    ]
                }
            },
            "name": "Is Attendance?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                660,
                300
            ]
        },
        {
            "parameters": {
                "values": {
                    "string": [
                        {
                            "name": "employee_id",
                            "value": "={{ $json.body.pc_name }}"
                        },
                        {
                            "name": "event_type",
                            "value": "={{ $json.body.action === 'INICIO_JORNADA' ? 'INICIO' : 'FIN' }}"
                        }
                    ]
                },
                "options": {
                    "dotNotation": false
                }
            },
            "name": "Map Attendance",
            "type": "n8n-nodes-base.set",
            "typeVersion": 1,
            "position": [
                880,
                200
            ]
        },
        {
            "parameters": {
                "operation": "insert",
                "table": "attendance_log",
                "columns": "employee_id, event_type",
                "options": {}
            },
            "name": "Insert Attendance",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 1,
            "position": [
                1100,
                200
            ],
            "credentials": {
                "postgres": {
                    "id": "YOUR_POSTGRES_CREDENTIALS_ID",
                    "name": "Supabase Account"
                }
            }
        },
        {
            "parameters": {
                "fieldToSplitOut": "body.activities",
                "options": {}
            },
            "name": "SplitOut",
            "type": "n8n-nodes-base.splitOut",
            "typeVersion": 1,
            "position": [
                880,
                420
            ]
        },
        {
            "parameters": {
                "values": {
                    "string": [
                        {
                            "name": "employee_id",
                            "value": "={{ $('Webhook').item.json.body.pc_name }}"
                        },
                        {
                            "name": "window_title",
                            "value": "={{ $json.window_title }}"
                        }
                    ],
                    "number": [
                        {
                            "name": "duration_seconds",
                            "value": "={{ $json.duration_seconds }}"
                        }
                    ]
                },
                "options": {
                    "dotNotation": false
                }
            },
            "name": "Map Activity",
            "type": "n8n-nodes-base.set",
            "typeVersion": 1,
            "position": [
                1060,
                420
            ]
        },
        {
            "parameters": {
                "operation": "insert",
                "table": "activity_log",
                "columns": "employee_id, window_title, duration_seconds",
                "options": {}
            },
            "name": "Insert Activity",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 1,
            "position": [
                1260,
                420
            ],
            "credentials": {
                "postgres": {
                    "id": "YOUR_POSTGRES_CREDENTIALS_ID",
                    "name": "Supabase Account"
                }
            }
        }
    ],
    "connections": {
        "Webhook": {
            "main": [
                [
                    {
                        "node": "Is Attendance?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Is Attendance?": {
            "main": [
                [
                    {
                        "node": "Map Attendance",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "SplitOut",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Map Attendance": {
            "main": [
                [
                    {
                        "node": "Insert Attendance",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "SplitOut": {
            "main": [
                [
                    {
                        "node": "Map Activity",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Map Activity": {
            "main": [
                [
                    {
                        "node": "Insert Activity",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}